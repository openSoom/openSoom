{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facilities"
  ],
  "properties": {
    "facilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "profile",
          "adapter",
          "read_only_roles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "adapter": {
            "enum": [
              "vendor-a",
              "vendor-b"
            ]
          },
          "read_only_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "observer"
              ]
            }
          },
          "maintenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assets",
              "freshness_seconds",
              "settle_seconds",
              "tolerance_pct"
            ],
            "properties": {
              "provider_profiles": {
                "type": "array", "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"}
              },
              "assets": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,47}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "asset_id",
                    "sensor_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "asset_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "sensor_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                }
              },
              "freshness_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "settle_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              },
              "tolerance_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  }
}
