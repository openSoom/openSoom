{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["facilities"],
  "properties": {"facilities": {"type": "array", "minItems": 1, "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "name", "profile", "adapter", "read_only_roles"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
      "name": {"type": "string", "minLength": 1, "maxLength": 100},
      "profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
      "adapter": {"enum": ["vendor-a", "vendor-b"]},
      "read_only_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["observer"]}}
    }
  }}}
}
